rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /game_progress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['highestStage', 'updatedAt'])
        && request.resource.data.highestStage is int
        && request.resource.data.highestStage >= 1
        && request.resource.data.highestStage <= 5;
    }
  }
}
